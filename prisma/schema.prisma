generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                String       @id @default(cuid())
  email             String       @unique
  password          String
  name              String
  role              String       @default("admin")
  departman         String       @default("yonetim")
  telefon           String?
  avatar            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  atananGorevler    KanbanKart[] @relation("Atanan")
  olusturanGorevler KanbanKart[] @relation("Olusturan")
  atananTodolar     Todo[]
  teklifler         Teklif[]
  etkinlikler       Etkinlik[]
  leadNotlari       LeadNot[]
  panolar           Pano[]       @relation("PanoOlusturan")
  gorevlerAtanan    Gorev[]      @relation("GorevAtanan")
  gorevlerOlusturan Gorev[]      @relation("GorevOlusturan")
}

model Musteri {
  id               String       @id @default(cuid())
  firmaAdi         String
  yetkiliKisi      String
  yetkiliUnvan     String?
  telefon          String
  email            String
  adres            String?
  vergiDairesi     String?
  vergiNo          String?
  kasaNo           String       @unique
  sifre            String
  magicToken       String?      @unique
  durum            String       @default("odeme_alinacak")
  notlar           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  teklifler        Teklif[]
  kanbanKartlari   KanbanKart[]
  timelineOlaylari Timeline[]
  todolar          Todo[]
  etkinlikler      Etkinlik[]
  gelirler         Gelir[]
  giderler         Gider[]
  projeler         Proje[]
  lead             Lead?
  gorevler         Gorev[]
}

model Teklif {
  id               String    @id @default(cuid())
  teklifNo         String    @unique
  musteriId        String
  musteri          Musteri   @relation(fields: [musteriId], references: [id], onDelete: Cascade)
  paketKategori    String
  paketAdi         String
  paketDetay       String?
  stratejiNotu     String?
  fiyat            Float
  ekGiderler       Json?
  islerListesi     Json?
  indirim          Float?    @default(0)
  kdvOrani         Float?    @default(20)
  toplam           Float
  gecerlilikTarihi DateTime
  durum                 String    @default("bekliyor")
  onayTarihi            DateTime?
  redTarihi             DateTime?
  wpGonderimZamani      DateTime?
  hatirlaticiGonderildi Boolean   @default(false)
  olusturanAdminId      String?
  olusturanAdmin        Admin?    @relation(fields: [olusturanAdminId], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model KanbanKart {
  id          String    @id @default(cuid())
  musteriId   String
  musteri     Musteri   @relation(fields: [musteriId], references: [id], onDelete: Cascade)
  baslik      String
  aciklama    String?
  sutun       String
  etiket      String?
  renk        String?
  sonTarih    DateTime?
  atananId    String?
  atanan      Admin?    @relation("Atanan", fields: [atananId], references: [id])
  olusturanId String?
  olusturan   Admin?    @relation("Olusturan", fields: [olusturanId], references: [id])
  sira        Int       @default(0)
  yorumlar    Json?
  altGorevler Json?
  dosyalar    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Timeline {
  id          String    @id @default(cuid())
  musteriId   String
  musteri     Musteri   @relation(fields: [musteriId], references: [id], onDelete: Cascade)
  baslik      String
  aciklama    String?
  baslangic   DateTime
  bitis       DateTime?
  tamamlandi  Boolean   @default(false)
  ilerleme    Int       @default(0)
  renk        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Todo {
  id         String    @id @default(cuid())
  musteriId  String
  musteri    Musteri   @relation(fields: [musteriId], references: [id], onDelete: Cascade)
  icerik     String
  tamamlandi Boolean   @default(false)
  sonTarih   DateTime?
  atananId   String?
  atanan     Admin?    @relation(fields: [atananId], references: [id])
  sira       Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Etkinlik {
  id          String    @id @default(cuid())
  musteriId   String?
  musteri     Musteri?  @relation(fields: [musteriId], references: [id], onDelete: SetNull)
  baslik      String
  aciklama    String?
  baslangic   DateTime
  bitis       DateTime?
  tumGun      Boolean   @default(false)
  renk        String?
  olusturanId String?
  olusturan   Admin?    @relation(fields: [olusturanId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Gelir {
  id             String    @id @default(cuid())
  musteriId      String?
  musteri        Musteri?  @relation(fields: [musteriId], references: [id])
  musteriAdi     String?
  gelirTuru      String
  tutar          Float
  kdvOrani       Float
  kdvDahil       Boolean   @default(true)
  netTutar       Float
  tarih          DateTime
  aciklama       String?
  dekontNo       String?
  dekontUrl      String?
  odemeYontemi   String?
  banka          String?
  tahsilatDurumu String
  kismiTutar     Float?
  vadeTarihi     DateTime?
  projeId        String?
  proje          Proje?    @relation(fields: [projeId], references: [id])
  wpMesajId      String?
  onayDurumu     String    @default("onaylandi")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Gider {
  id           String    @id @default(cuid())
  kategori     String
  altKategori  String?
  tutar        Float
  kdvOrani     Float?
  kdvDahil     Boolean   @default(true)
  netTutar     Float
  tarih        DateTime
  aciklama     String?
  fisNo        String?
  fisUrl       String?
  odemeYontemi String?
  banka        String?
  odemeDurumu  String
  kismiTutar   Float?
  vadeTarihi   DateTime?
  musteriId    String?
  musteri      Musteri?  @relation(fields: [musteriId], references: [id])
  projeId      String?
  proje        Proje?    @relation(fields: [projeId], references: [id])
  wpMesajId    String?
  onayDurumu   String    @default("onaylandi")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WPMesaj {
  id            String    @id @default(cuid())
  mesaj         String
  telNo         String
  tarih         DateTime  @default(now())
  islemTipi     String?
  tutar         Float?
  kategori      String?
  aciklama      String?
  ilgiliGelirId String?
  ilgiliGiderId String?
  durum         String    @default("bekliyor")
  notlar        String?
  createdAt     DateTime  @default(now())
}

model WPSohbet {
  id             String          @id @default(cuid())
  telNo          String          @unique
  isim           String?
  kaynak         String          @default("whatsapp")
  sonMesaj       String?
  sonMesajZamani DateTime?
  okunmadi       Boolean         @default(false)
  mesajlar       WPSohbetMesaj[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model WPSohbetMesaj {
  id              String   @id @default(cuid())
  sohbetId        String
  sohbet          WPSohbet @relation(fields: [sohbetId], references: [id], onDelete: Cascade)
  yon             String
  icerik          String
  medyaTipi       String?
  medyaAdi        String?
  waMedyaId       String?
  gonderenAdminId String?
  waMesajId       String?
  createdAt       DateTime @default(now())
}

model BankaHesabi {
  id        String   @id @default(cuid())
  ad        String
  hesapNo   String?
  iban      String?
  bakiye    Float?
  createdAt DateTime @default(now())
}

model Lead {
  id           String    @id @default(cuid())
  adSoyad      String?
  firmaAdi     String?
  telefon      String?
  email        String?
  hizmetIlgisi String?
  mesaj        String?
  sehir        String?
  kaynak       String    @default("Web Sitesi")
  reklamDetay  String?
  durum        String    @default("yeni_lead")
  takipNotu    String?
  musteriId    String?   @unique
  musteri      Musteri?  @relation(fields: [musteriId], references: [id])
  notlar       LeadNot[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LeadNot {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  icerik      String
  olusturanId String?
  olusturan   Admin?   @relation(fields: [olusturanId], references: [id])
  createdAt   DateTime @default(now())
}

model Proje {
  id         String    @id @default(cuid())
  musteriId  String
  musteri    Musteri   @relation(fields: [musteriId], references: [id])
  ad         String
  baslangic  DateTime?
  bitis      DateTime?
  butce      Float?
  createdAt  DateTime  @default(now())
  gelirler   Gelir[]
  giderler   Gider[]
}


model Randevu {
  id         String   @id @default(cuid())
  tarih      String
  saat       String
  adaySoyad  String
  telefon    String
  pozisyon   String   @default("Satış Yöneticisi")
  notlar     String?
  createdAt  DateTime @default(now())

  @@unique([tarih, saat])
}

model RandevuAyar {
  id            String   @id @default("singleton")
  gunler        String   @default("[]")
  baslangicSaat String   @default("09:00")
  bitisSaat     String   @default("18:00")
  slotDakika    Int      @default(30)
  updatedAt     DateTime @updatedAt
}

model WASablon {
  id               String   @id @default(cuid())
  baslik           String
  kategori         String   @default("Genel")
  metaTemplateName String
  parametreler     String   @default("[]")
  onizlemeMetni    String?
  govde            String?
  metaDurum        String   @default("mevcut")
  metaTemplateId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Arama {
  id              String    @id @default(cuid())
  callSid         String    @unique
  kimden          String
  kime            String
  marka           String    @default("Spok.mp4")
  durum           String    @default("basladi")
  sureSaniye      Int?
  kayitUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Pano {
  id          String   @id @default(cuid())
  ad          String
  departman   String
  olusturanId String?
  olusturan   Admin?   @relation("PanoOlusturan", fields: [olusturanId], references: [id])
  gorevler    Gorev[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gorev {
  id          String    @id @default(cuid())
  panoId      String
  pano        Pano      @relation(fields: [panoId], references: [id], onDelete: Cascade)
  baslik      String
  aciklama    String?
  durum       String    @default("yapilacak")
  oncelik     String    @default("normal")
  musteriId   String?
  musteri     Musteri?  @relation(fields: [musteriId], references: [id], onDelete: SetNull)
  atananId    String?
  atanan      Admin?    @relation("GorevAtanan", fields: [atananId], references: [id])
  olusturanId String?
  olusturan   Admin?    @relation("GorevOlusturan", fields: [olusturanId], references: [id])
  sonTarih    DateTime?
  etiket      String?
  yorumlar    Json?
  dosyalar    Json?
  sira        Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
